# Pomotask — Environment Variables
#
# Copy this file to .env and fill in the values for local development.
# .env is gitignored and never committed.
#
# Without VITE_CONVEX_URL the app runs fully offline with Dexie (IndexedDB).
# Set it to enable cloud sync, auth, and the Dexie → Convex migration flow.

# ─── Convex Backend (frontend) ────────────────────────────────────

# The URL of your Convex deployment. Get this from the Convex dashboard:
#   https://dashboard.convex.dev → your project → Deployments → dev deployment URL
# Alternatively, run `npx convex dev` and the CLI prints the URL after setup.
VITE_CONVEX_URL=https://<your-deployment>.convex.cloud

# ─── Convex Dashboard env vars (server-side, NOT in this file) ────
#
# Set these in the Convex dashboard → Settings → Environment Variables,
# or via `npx convex env set <NAME> <VALUE>` while `npx convex dev` is running.
#
# Required for auth (email/password and Google OAuth):
#   SITE_URL=http://localhost:5173          # dev origin (use production URL in prod)
#   AUTH_SECRET=<auto-generated on first deploy>
#
# Required for Google Sign-In (optional provider — app works without it):
#   AUTH_GOOGLE_ID=<Google OAuth client ID>
#   AUTH_GOOGLE_SECRET=<Google OAuth client secret>
#
# Google OAuth redirect URI (add in Google Cloud Console → Credentials):
#   https://<your-deployment>.convex.site/api/auth/callback/google
#
# Generate local Convex types without deploy keys:
#   node scripts/generate-convex-types.mjs

# ─── CI/CD Only (not needed for local dev) ─────────────────────────

# Deploy key from Convex dashboard → Settings → Deploy Keys
# CONVEX_DEPLOY_KEY=<your-deploy-key>

# Deployment name (e.g., "prod"). Used by `npx convex deploy` and CI.
# CONVEX_DEPLOYMENT=prod

# Auth secret used to sign JWT tokens. Convex generates this automatically
# on deploy, but CI needs it explicitly if deploying from CI.
# AUTH_SECRET=<your-auth-secret>
